# Custom build of PiGallery2 3.5.2 with local patches:
#   1. Lightbox preview sized to physical (devicePixelRatio-scaled) pixels -> no blurry HiDPI previews
#   2. Close-lightbox key changed from Escape to 'x'
#
# Stage `srcbuild` compiles the app from source into ./release.
# Stages `builder`/`main` are the upstream docker/alpine/Dockerfile.build, fed from srcbuild.

#-----------------SRC BUILD---------------
#-----------------------------------------
FROM node:22-alpine3.22 AS srcbuild
ENV SHARP_FORCE_GLOBAL_LIBVIPS=1
ENV NODE_OPTIONS=--max_old_space_size=4096
RUN apk add --no-cache --update \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/testing \
    vips vips-dev vips-heif vips-magick libheif libpng libjpeg-turbo \
    libde265 libwebp libraw-dev g++ make gcc build-base python3 pkgconfig git
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# tsc compiles gulpfile.ts -> gulpfile.js; `create-release` assembles ./release
# (production frontend -> ./release/dist, compiled backend, static files, package.json).
RUN npx tsc && npx gulp create-release

#-----------------BUILDER-----------------
#-----------------------------------------
FROM node:22-alpine3.22 AS builder

ENV SHARP_FORCE_GLOBAL_LIBVIPS=1
RUN apk add --no-cache --update \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/testing \
    vips \
    vips-dev \
    vips-heif \
    vips-magick \
    libheif \
    libpng \
    libjpeg-turbo \
    libde265 \
    libwebp \
    libraw-dev \
    g++ \
    make \
    gcc \
    build-base \
    python3 \
    pkgconfig

COPY --from=srcbuild /src/release /app
WORKDIR /app
RUN npm install --no-package-lock --save-dev node-addon-api@8.5.0 node-gyp@11.5.0  && \
    npm prune --production && \
    npm cache clean --force


RUN mkdir -p /app/data/config && \
    mkdir -p /app/data/db && \
    mkdir -p /app/data/images && \
    mkdir -p /app/data/tmp


#-----------------MAIN--------------------
#-----------------------------------------
FROM node:22-alpine3.22 AS main
WORKDIR /app
ENV NODE_ENV=production \
    # overrides only the default value of the settings (the actual value can be overwritten through config.json)
    default-Database-dbFolder=/app/data/db \
    default-Media-folder=/app/data/images \
    default-Media-tempFolder=/app/data/tmp \
    default-Extensions-folder=/app/data/config/extensions \
    # flagging dockerized environment
    PI_DOCKER=true

EXPOSE 80
ARG TARGETARCH
# IMPORTANT: pull vips from the SAME edge repos used in the builder stage.
# sharp is compiled against the builder's libvips; if the runtime libvips differs
# (Alpine stable lags edge), the ABI/enum mismatch breaks thumbnailing with
# "vips_colourspace: no known route from 'srgb' to 'last'".
RUN apk add --no-cache \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/main \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community \
    --repository=https://dl-cdn.alpinelinux.org/alpine/edge/testing \
    vips vips-cpp vips-heif vips-magick ffmpeg \
    && if [ "$TARGETARCH" = "amd64" ]; then \
        echo "Building for amd64, adding intel-media-driver" && \
        apk add --no-cache intel-media-driver; \
    fi \
    && rm -rf /var/cache/apk/*
COPY --from=builder /app /app

# Run build time diagnostics to make sure the app would work after build is finished
RUN ["node", "--expose-gc", "./src/backend/index", "--run-diagnostics", "--config-path=/app/diagnostics-config.json", "--Server-Log-level=silly"]
HEALTHCHECK --interval=40s --timeout=30s --retries=3 --start-period=60s \
  CMD wget --quiet --tries=1 --no-check-certificate --spider \
  http://127.0.0.1:80/heartbeat || exit 1

ENTRYPOINT ["node", "--expose-gc", "./src/backend/index", "--config-path=/app/data/config/config.json"]
