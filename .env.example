# Copy to .env and edit for this machine:  cp .env.example .env
#
# .env is gitignored -- it holds host-specific paths, so every machine keeps
# its own without ever conflicting in git.

# REQUIRED: absolute path to your photo library on THIS host.
# Mounted read-only; PiGallery2 never modifies originals.
# Leave it wrong and you get an empty gallery with no error: Docker silently
# creates a missing bind-mount source as an empty directory.
PHOTOS_DIR=/path/to/your/photos

# Host port for the web UI (container always listens on 80).
HTTP_PORT=8082
